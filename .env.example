# Copy to .env for local development. Every value can also be set as an environment variable.

# --- service ---------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# json (production) or console (human-friendly)
LOG_FORMAT=console
PORT=8000
# Comma-separated origins allowed to call the API cross-origin (empty = same-origin only)
CORS_ORIGINS=

# --- persistence -----------------------------------------------------------------------------
# SQLite by default; for PostgreSQL use postgresql+asyncpg://user:pass@host:5432/autoswe
DATABASE_URL=sqlite+aiosqlite:///./data/autoswe.db
DB_AUTO_MIGRATE=true

# --- auth ------------------------------------------------------------------------------------
# Comma-separated principal:key pairs (keys >= 16 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Local development only: accept unauthenticated requests as the "anonymous" principal.
AUTH_DISABLED=true

# --- worker ----------------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
MAX_ACTIVE_JOBS_PER_OWNER=3
MAX_REPAIR_ROUNDS=1

# --- LLM providers ---------------------------------------------------------------------------
# auto = anthropic when a key is configured, otherwise the deterministic offline provider
LLM_DEFAULT_PROVIDER=auto
# Demo pacing for the offline provider: seconds to wait per agent call (0 = instant)
OFFLINE_DELAY_S=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional: force one effort level (low|medium|high|xhigh|max) for every agent
ANTHROPIC_EFFORT=
ANTHROPIC_MAX_TOKENS=64000

# --- sandboxed test execution ----------------------------------------------------------------
# none (default): generated tests are not run. remote: the sandbox runner service (compose
# default; the only process with Docker access). docker: this process starts the containers
# (root-equivalent; CI and local work only). local: plain subprocess, NOT isolated (dev only).
SANDBOX_BACKEND=none
SANDBOX_IMAGE=autoswe-sandbox:local
# SANDBOX_RUNNER_URL=http://sandbox-runner:8080
# SANDBOX_RUNNER_TOKEN=   # at least 16 characters, shared by the API and the runner
# Optional gVisor runtime for every sandbox container (the daemon must have runsc installed)
SANDBOX_DOCKER_RUNTIME=
SANDBOX_TIMEOUT_S=120
SANDBOX_MEMORY_MB=768
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_MAX_REPAIR_ROUNDS=2
